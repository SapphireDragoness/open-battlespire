{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BS_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug + ASan/UBSan",
            "binaryDir": "${sourceDir}/build/asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BS_WARNINGS_AS_ERRORS": "ON",
                "BS_SANITIZE": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "fuzz",
            "displayName": "libFuzzer (Clang, ASan/UBSan)",
            "binaryDir": "${sourceDir}/build/fuzz",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BS_WARNINGS_AS_ERRORS": "ON",
                "BS_FUZZ": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "fuzz",
            "configurePreset": "fuzz"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
